# AI
OPENAI_API_KEY=sk-...
ANTHROPIC_API_KEY=sk-ant-...

# База данных (PostgreSQL)
DATABASE_URL=postgresql+asyncpg://postgres:postgres@db:5432/smeta_ai

# JWT
JWT_SECRET=change-me-use-a-random-64-char-string-in-production
JWT_ALGORITHM=HS256
JWT_EXPIRE_HOURS=24

# Пароли пользователей (хешируются при первом запуске)
USER_PASSWORD=user123
ADMIN_PASSWORD=admin123

# Ограничения загрузки файлов
MAX_FILE_SIZE_MB=20
MAX_FILES_PER_REQUEST=10
TASK_TIMEOUT_SECONDS=600

# CORS (через запятую)
CORS_ORIGINS=http://localhost:5173,http://localhost:3000
